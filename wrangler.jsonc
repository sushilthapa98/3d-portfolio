// Cloudflare Worker that serves the Vite build output (dist/) as static assets.
// Deploy with `npm run build`, then `npx wrangler deploy`.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "3d-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // run src/worker.js first so it can redirect www to the main domain
    "run_worker_first": true
  }
}
